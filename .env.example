# ==============================================================================
# Vidyabot Environment Configuration
# ==============================================================================
# In DEMO MODE (Default), Vidyabot requires ZERO environment variables or secrets!
# The app is fully self-contained using browser LocalStorage and seeded curriculum.
#
# When you choose to activate cloud database sync and live Gemini AI model streaming:
# ==============================================================================

# [OPTIONAL] Server-Side Gemini API Key (for live cloud model inference)
GEMINI_API_KEY=""

# [OPTIONAL] Cloud Run Host URL (automatically injected in production)
APP_URL=""

# [OPTIONAL] Self-hosted n8n webhook — fires a background "session complete"
# notification after a post-test. If left blank, this feature is simply
# skipped; the app works identically either way.
VITE_N8N_WEBHOOK_URL=""

# [OPTIONAL] Self-hosted n8n RAG retrieval webhook — retrieves answers from
# uploaded textbook material for doubts the local knowledge base can't
# answer, before falling back to Gemini. If left blank, this step is simply
# skipped and the doubt tutor behaves exactly as before.
VITE_N8N_RAG_WEBHOOK_URL=""

# [OPTIONAL] Firebase / Cloud Firestore Configuration (for remote cloud persistence)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
